{
  "name": "medleyplay-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web client for medleyplay, a music player for the local network.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typescript/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint:js": "eslint . --cache --cache-location .cache/eslint/",
    "lint:css": "stylelint \"src/**/*.css\" --cache --cache-location .cache/stylelint/",
    "format": "prettier --check . --cache --cache-location .cache/prettier/.prettier-cache",
    "format:write": "prettier --write . --cache --cache-location .cache/prettier/.prettier-cache",
    "check": "npm run typecheck && npm run lint:js && npm run lint:css && npm run format && npm run test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
